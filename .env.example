DISCORD_TOKEN=
# Register commands in this server only (instant), instead of globally. Leave blank in production.
DISCORD_DEV_GUILD_ID=

# Optional
# DATABASE_PATH=data/basura.sqlite
# Requests a minute sent to AniList. 30 is AniList's current limit.
# ANILIST_REQUESTS_PER_MINUTE=30
# Valkey cache for AniList responses. Required: AniList's rate limits are strict.
# REDIS_URL=redis://127.0.0.1:6379
# LOG_LEVEL=info
# Health check server
# HOST=127.0.0.1
# PORT=8080
