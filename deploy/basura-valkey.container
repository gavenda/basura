[Unit]
Description=Basura cache (Valkey), required by the bot

[Container]
ContainerName=basura-valkey
Image=docker.io/valkey/valkey:9-alpine
Pod=basura.pod

# A cache only: nothing is saved to disk, and the oldest keys go first once it's full.
# Bound to the pod's loopback, so only the bot can reach it.
# `--save` with no value turns snapshots off. Don't write `--save ""`: Quadlet drops an empty
# argument and everything after it.
Exec=valkey-server --bind 127.0.0.1 --port 6379 --save --appendonly no --maxmemory 128mb --maxmemory-policy allkeys-lru

# Runs as the image's valkey user from the start, so the entrypoint needs no capabilities to drop root.
User=valkey
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

HealthCmd=valkey-cli ping
HealthInterval=10s
HealthStartPeriod=5s
HealthRetries=3
HealthOnFailure=kill
# The unit counts as started once Valkey answers, so the bot starts after it.
Notify=healthy

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
