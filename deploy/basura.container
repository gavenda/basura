[Unit]
Description=Basura Discord bot
Wants=network-online.target
After=network-online.target
# The cache is required (AniList's rate limits are strict): start after Valkey is healthy, and stop with it.
Requires=basura-valkey.service
After=basura-valkey.service

[Container]
ContainerName=basura
# Published by .github/workflows/publish.yml. To run an image built from a local
# checkout instead, `bun run image`, set `Image=localhost/basura:latest` and drop
# AutoUpdate below, since there is no registry to check.
Image=ghcr.io/gavenda/basura:latest

# `podman auto-update` (enable podman-auto-update.timer) pulls a newer :latest
# and restarts this unit, rolling back automatically if the new image fails.
AutoUpdate=registry
Pod=basura.pod
# DISCORD_TOKEN, and anything else from .env.example.
EnvironmentFile=%h/.config/basura/basura.env
Volume=basura-data.volume:/data
# Valkey, in the same pod.
Environment=REDIS_URL=redis://127.0.0.1:6379
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
# Fails while the gateway connection is down. Checked from inside the container, so no port is published.
HealthCmd=wget -q -O /dev/null http://127.0.0.1:8080/health
HealthStartPeriod=60s
HealthInterval=30s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
