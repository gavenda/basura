{
  "name": "basura",
  "version": "3.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --minify --sourcemap=linked --outdir=dist",
    "commands:deploy": "bun src/discord/deploy-commands.ts",
    "image": "podman build -t localhost/basura:latest -f Containerfile .",
    "format": "bun fmt src",
    "prepare": "husky",
    "type-check": "tsc",
    "codegen": "graphql-codegen",
    "format:check": "bun fmt --check src"
  },
  "author": "Gavenda <gavenda@disroot.org>",
  "license": "MIT",
  "dependencies": {
    "@logtape/logtape": "^2.4.2",
    "discord.js": "^14.27.0",
    "gqlmin": "^0.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript-operations": "^6.2.0",
    "@types/bun": "^1.4.4",
    "graphql": "^17.0.2",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  }
}
